# IMPORTANT: Copy this to Railway Variables
# Don't commit actual .env with secrets to GitHub!

APP_NAME="ReTech Market"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-app.railway.app

# Database (Railway MySQL - auto-filled by Railway)
# Leave DATABASE_URL empty - Railway will inject it

# Broadcasting
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_key
PUSHER_APP_SECRET=your_pusher_secret
PUSHER_APP_CLUSTER=eu

# Vite Build Variables (REQUIRED at build time!)
# These MUST be set in Railway or CI/CD
VITE_PUSHER_APP_KEY=${PUSHER_APP_KEY}
VITE_PUSHER_APP_CLUSTER=${PUSHER_APP_CLUSTER}

# Cache & Queue
CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=database

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls

# Payment (Kkiapay)
KKIAPAY_PUBLIC_KEY=your_public_key
KKIAPAY_PRIVATE_KEY=your_private_key
KKIAPAY_SECRET=your_secret
KKIAPAY_MODE=sandbox
